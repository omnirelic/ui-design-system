{
  "name": "@omnirelic/ui-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Identité visuelle omnirelic — tokens + composants React (web aujourd'hui, React Native demain) consommés par tous les providers du réseau.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -b",
    "dev": "tsc -b --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-qr-code": ">=2"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "react-qr-code": "^2.2.0",
    "typescript": "^5.6.3"
  }
}
